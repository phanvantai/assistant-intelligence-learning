# Copy file này thành .env và điền giá trị thật. File .env không được commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tuỳ chọn: đơn giá USD cho 1 triệu token, tra ở trang giá chính thức của Google.
# Để trống thì app chỉ hiện số token, không tính tiền.
GEMINI_INPUT_PRICE_PER_1M=
GEMINI_OUTPUT_PRICE_PER_1M=
