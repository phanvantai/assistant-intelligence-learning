# Copy file này thành .env và điền giá trị thật. File .env không được commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tuỳ chọn: ghi đè đơn giá USD cho 1 triệu token. App đã có sẵn bảng giá
# chính thức cho gemini-3.5-flash-lite, gemini-3.1-flash-lite và gemini-3.8-flash
# (xem MODEL_PRICES trong app/config.py), nên thường để trống.
# Chỉ điền khi dùng model khác hoặc muốn tự chốt giá riêng.
GEMINI_INPUT_PRICE_PER_1M=
GEMINI_OUTPUT_PRICE_PER_1M=
